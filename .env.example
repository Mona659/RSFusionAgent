# Keep real API keys in .env. Never commit .env.
# The CLI does not load .env automatically; set these in your terminal or secret manager.
RSFUSION_LLM_PROVIDER=qwen
RSFUSION_LLM_API_KEY=
RSFUSION_LLM_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RSFUSION_LLM_MODEL=qwen3.7-flash

# Provider-native fallbacks are supported for local development.
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# Python executable of the existing CUDA/PyTorch model environment.
# Example: C:\Users\you\.conda\envs\model-env\python.exe
RSFUSION_MODEL_PYTHON=
